# Diako — variables d'environnement (copier en .env.local pour surcharger).
#
# Ces deux valeurs ont un repli codé en dur dans src/integrations/supabase/client.ts :
# l'application fonctionne sans fichier .env. La clé « anon » est PUBLIQUE par
# nature (elle est dans le bundle livré au navigateur) — la sécurité repose
# entièrement sur la RLS, jamais sur son secret.

VITE_SUPABASE_URL=https://eifrwecaszzqrdwjjjbu.supabase.co
VITE_SUPABASE_ANON_KEY=

# ⚠ NE JAMAIS mettre ici : la clé service_role, le mot de passe FTP o2switch,
#   la clé d'API d'upload, les identifiants SMTP. Ils vivent dans
#   ~/.diako-secrets et dans les secrets Supabase, jamais dans le dépôt.
