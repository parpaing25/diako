# ============================================================================
# DIAKO — configuration Apache (o2switch)
#
# ⚠ CE FICHIER EST VERSIONNÉ, ET C'EST VOLONTAIRE.
#   Sur le Diako précédent, le .htaccess n'existait QUE sur le serveur : non
#   versionné, non sauvegardé, et personne ne savait ce qu'il contenait.
#   Toute modification se fait ici, puis part au déploiement.
# ============================================================================

# ── Sécurité ────────────────────────────────────────────────────────────────
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # ── Content-Security-Policy ───────────────────────────────────────────
  # 🔴 `img-src` A CASSÉ TOUTES LES PHOTOS DE PROFIL GOOGLE. La connexion
  #    Google renvoie un avatar hébergé sur lh3.googleusercontent.com ; la
  #    première version de cette règle ne l'autorisait pas, et le navigateur le
  #    bloquait EN SILENCE — l'écran affichait le texte de remplacement
  #    « Ma photo de profil » à la place de l'image, sur le compte, dans le fil
  #    et sous chaque commentaire. Une CSP qui casse la fonctionnalité qu'elle
  #    protège n'est pas un durcissement, c'est une panne.
  # ⚠ Toute source d'images AJOUTÉE AU PRODUIT doit être ajoutée ici le même
  #   jour : Facebook (fbcdn) pour la connexion FB, Wikimedia pour les photos de
  #   sites servies en secours. Le symptôme est muet, on ne le trouve qu'en
  #   regardant la console.
  # ⚠ ELLE MANQUAIT ENTIÈREMENT. C'était le seul filet manquant contre une URL
  #   `javascript:` saisie par un gérant dans « site web » — la contrainte en
  #   base (migration 0036) ferme la porte d'entrée, la CSP ferme la sortie.
  #
  # ⚠ `'unsafe-inline'` SUR script-src EST NÉCESSAIRE ET ASSUMÉ : index.html
  #   porte le squelette statique et le JSON-LD en ligne, et Vite injecte son
  #   module de préchargement. Les retirer demanderait un nonce, donc un rendu
  #   dynamique de la page — ce qu'un hébergement mutualisé ne fait pas ici.
  #   Ce qui compte le plus est déjà là : `object-src 'none'` (pas de Flash ni
  #   d'embed), `base-uri 'self'` (on ne détourne pas les URL relatives) et
  #   `frame-ancestors 'self'` (pas de détournement de clic).
  #
  # ⚠ LES ORIGINES AUTORISÉES SONT CELLES QUE LE SITE UTILISE VRAIMENT :
  #   Supabase (base + fonctions), o2switch (images), OpenStreetMap (tuiles de
  #   la carte). Rien d'autre — pas de CDN de police, le site n'en charge plus.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://diako.fonenako.mg https://fonenako.mg https://*.supabase.co https://*.tile.openstreetmap.org https://*.googleusercontent.com https://*.fbcdn.net https://upload.wikimedia.org; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://diako.fonenako.mg https://nominatim.openstreetmap.org https://overpass-api.de; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
</IfModule>

# Fichiers sensibles : jamais servis.
<FilesMatch "(^\.|\.(env|sql|log|bak|ini|sh|yml|json5)$|composer\.(json|lock))">
  Require all denied
</FilesMatch>

# ⚠ NE PAS utiliser <Directory> ici : cette directive est INTERDITE dans un
#   .htaccess (elle n'est valable qu'en configuration serveur) et provoque un
#   500 sur tout le site. Idem pour php_flag, qui n'existe pas sous PHP-FPM.
#   La protection des dossiers d'images est faite par public/uploads/.htaccess.

# ── HTTPS + apex ────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Le sitemap est GENERE depuis la base : /sitemap.xml sert sitemap.php.
  # Le fichier statique ne listait que quatre URL — ni les 178 destinations,
  # ni les etablissements. Google ne savait donc pas qu'ils existaient.
  # ⚠ Cette regle doit venir AVANT le repli SPA, sinon /sitemap.xml
  #   retomberait sur index.html des que le .xml statique est retire.
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # ── APERÇU DE PARTAGE ────────────────────────────────────────────────
  # Les robots de partage n'exécutent PAS JavaScript : sur une application
  # monopage, ils ne voient donc que les métas génériques de index.html. Coller
  # un lien d'hôtel dans WhatsApp affichait « Diako — Voyage & tourisme »,
  # pour les 220 URL du sitemap. Or WhatsApp et Messenger SONT le canal
  # d'acquisition sur ce marché.
  #
  # ⚠ GOOGLEBOT EST VOLONTAIREMENT ABSENT DE CETTE LISTE. Il exécute le
  #   JavaScript et voit donc la vraie page ; lui servir une version distincte
  #   serait du cloaking, et se paie cher. Ici on ne sert pas un autre contenu :
  #   c'est la même information, dans le seul format qu'un robot de partage
  #   sait lire.
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Discordbot|Slackbot|TelegramBot|Pinterest|SkypeUriPreview|vkShare|redditbot|Applebot) [NC]
  RewriteCond %{REQUEST_URI} !^/(partage\.php|sitemap\.php|api/|assets/|media/|uploads/) [NC]
  RewriteRule ^ /partage.php [L]

  # Repli SPA : tout ce qui n'est ni un fichier ni un dossier existant
  # retourne index.html (React Router prend le relais).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^ index.html [L]
</IfModule>

# ── Cache ───────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Assets hachés par Vite : immuables, un an.
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images : 30 jours.
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # ⚠ JAMAIS de cache sur ces deux-là : un index.html ou un sw.js caché fige
  # les visiteurs sur une version morte du site après un déploiement.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # app-init.js : 1 h. Assez court pour qu'un correctif se propage vite,
  # assez long pour ne pas être redemandé à chaque page.
  <Files "app-init.js">
    ExpiresDefault "access plus 1 hour"
  </Files>
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ── Types ───────────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
